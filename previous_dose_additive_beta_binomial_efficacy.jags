model {

  ############################################################
  # Dose-specific beta-binomial efficacy model with additive
  # previous-dose carryover for recycled/IPDE administrations.
  #
  # Each dose has an independently fitted marginal regular-efficacy
  # probability with the intended Beta(a_regular[j], b_regular[j]) prior,
  # represented as a ratio of independent Gamma variables.
  # For patient i at current dose dose[i], the efficacy probability is:
  #
  # Regular administration:
  #   Pr(E[i] = 1) = p_regular[dose[i]]
  #
  # Recycled/IPDE administration:
  #   Pr(E[i] = 1) = min(
  #     1,
  #     p_regular[dose[i]] + alpha * p_regular[previous_dose[i]]
  #   )
  #
  # The Bernoulli likelihood below is the individual-level form of a
  # beta-binomial model. Individual rows are necessary because recycled
  # patients can have different previous doses and therefore cannot be
  # aggregated by current dose alone.
  #
  # Required data:
  #   N                 : total number of administrations
  #   ndose             : number of dose levels
  #   eff[i]            : binary efficacy outcome, 0/1
  #   dose[i]           : current dose, integer 1,...,ndose
  #   previous_dose[i]  : patient's immediately preceding dose, 1,...,ndose
  #   ipde[i]           : 0 = regular, 1 = recycled/IPDE administration
  #   a_regular[j], b_regular[j] : dose-specific Beta-prior shapes
  #   a_alpha, b_alpha  : Beta-prior shapes for carryover alpha
  #
  # previous_dose[i] must be a valid dose index even for regular rows;
  # use any valid sentinel (for example, 1) when ipde[i] = 0.
  ############################################################

  # Gamma variables in each ratio have the same rate, so the derived
  # quantity has the corresponding intended Beta prior.
  g_alpha_1 ~ dgamma(a_alpha, 1)
  g_alpha_2 ~ dgamma(b_alpha, 1)
  alpha <- g_alpha_1 / (g_alpha_1 + g_alpha_2)

  for (j in 1:ndose) {
    g_regular_1[j] ~ dgamma(a_regular[j], 1)
    g_regular_2[j] ~ dgamma(b_regular[j], 1)
    p_regular[j] <- g_regular_1[j] /
                    (g_regular_1[j] + g_regular_2[j])
  }

  for (i in 1:N) {
    theta_regular[i] <- p_regular[dose[i]]
    theta_ipde[i] <- min(
      1,
      p_regular[dose[i]] + alpha * p_regular[previous_dose[i]]
    )
    theta[i] <- (1 - ipde[i]) * theta_regular[i] +
                ipde[i] * theta_ipde[i]

    eff[i] ~ dbern(theta[i])
  }
}
