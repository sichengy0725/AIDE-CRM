model {
  # Arbitrary-cycle additive TITE-CRM. State index one is an explicit
  # zero-state sentinel. The state is uncapped; each administration-level
  # toxicity probability is capped before its TITE contribution.
  beta ~ dnorm(beta_mean, tau_beta)
  g_alpha_1 ~ dgamma(a_r, 1)
  g_alpha_2 ~ dgamma(b_r, 1)
  alpha <- g_alpha_1 / (g_alpha_1 + g_alpha_2)

  for (j in 1:J) {
    p[j] <- pow(q[j], exp(beta))
    theta_ipde[j] <- min(1, p[j] + alpha * p[j])
  }

  # Every administration contributes to the uncapped state recursion and its
  # own TITE likelihood contribution.
  state_tox[1] <- 0
  for (r in 1:N) {
    state_tox[r + 1] <- p[dose[r]] + alpha * state_tox[previous_state_index[r]]
    q_tox_admin[r] <- min(1, state_tox[r + 1])
    theta_admin[r] <- w[r] * q_tox_admin[r]
    y[r] ~ dbern(theta_admin[r])
  }
}
