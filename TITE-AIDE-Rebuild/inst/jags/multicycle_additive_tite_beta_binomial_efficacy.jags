model {
  # Arbitrary-cycle shared-alpha delayed-outcome efficacy model. State index
  # one is an explicit zero-state sentinel. The zeros-trick likelihood keeps
  # the existing administration-level pending-nonresponse contribution (1 - q)^weight.
  g_alpha_1 ~ dgamma(a_alpha, 1)
  g_alpha_2 ~ dgamma(b_alpha, 1)
  alpha <- g_alpha_1 / (g_alpha_1 + g_alpha_2)

  for (j in 1:ndose) {
    g_regular_1[j] ~ dgamma(a_regular[j], 1)
    g_regular_2[j] ~ dgamma(b_regular[j], 1)
    p_regular[j] <- g_regular_1[j] / (g_regular_1[j] + g_regular_2[j])
  }

  # Every administration contributes to the uncapped state recursion and its
  # own delayed-efficacy likelihood contribution.
  state_eff[1] <- 0
  for (r in 1:N) {
    state_eff[r + 1] <- p_regular[dose[r]] + alpha * state_eff[previous_state_index[r]]
    q_eff_admin[r] <- min(1, state_eff[r + 1])
    theta_safe[r] <- max(eps, min(1 - eps, q_eff_admin[r]))
    loglik[r] <- eff_ascertained[r] * eff[r] * log(theta_safe[r]) +
      (eff_ascertained[r] * (1 - eff[r]) +
       (1 - eff_ascertained[r]) * eff_weight[r]) * log(1 - theta_safe[r])
    phi[r] <- -loglik[r] + zero_trick_constant
    zeros[r] ~ dpois(phi[r])
  }
}
